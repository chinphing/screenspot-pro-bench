# 复制成 .env 再填值：cp .env.example .env
#
# .env 已被 .gitignore 排除，不会入库。
# bench/clients.py 启动时用 python-dotenv 自动读本文件；
# 已经 export 的同名环境变量优先（load_dotenv 默认不覆盖）。
#
# 为什么不用 /tmp：macOS 会定期清理 /tmp，之前放的 /tmp/qw.env 就被清过一次，
# 导致跑到一半发现没有 key。

# ── Qwen（阿里云 DashScope 兼容模式）──────────────────────────
# 基线默认后端就是 qwen，只跑 M1/M2/M3 的话填这几行就够。
QW_KEY=
QW_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QW_MODEL=qwen3.8-flash

# ── DeepSeek ────────────────────────────────────────────────
# 只在 --backend deepseek 时需要。DS_BASE 默认 https://api.deepseek.com/v1
DS_KEY=
# DS_BASE=https://api.deepseek.com/v1
# DS_MODEL=deepseek-flash
